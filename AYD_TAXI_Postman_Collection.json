{
	"info": {
		"_postman_id": "a9187c32-8e12-4c28-98e3-ayd-taxi-api-test",
		"name": "AYD TAXI - Auditoría de API con Postman",
		"description": "Colección de Postman para pruebas de auditoría de seguridad API (Registro, Login, Perfil y Logout).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "bearer_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. POST /api/register - Datos válidos",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Usuario Postman\",\n  \"email\": \"postman.user@aydtaxi.com\",\n  \"password\": \"password123\",\n  \"role\": \"pasajero\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"register"
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Respuesta contiene token\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"    pm.expect(jsonData).to.have.property(\"token\");",
							"    if (jsonData.token) {",
							"        pm.collectionVariables.set(\"bearer_token\", jsonData.token);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "2. POST /api/register - Datos inválidos",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"\",\n  \"email\": \"correo_invalido\",\n  \"password\": \"123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"register"
