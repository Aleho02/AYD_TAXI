				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 422 Unprocessable Entity (Validación)\", function () {",
							"    pm.response.to.have.status(422);",
							"});",
							"pm.test(\"Contiene errores de validación\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"errors\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "3. POST /api/register - Correo duplicado",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Duplicado Test\",\n  \"email\": \"admin@aydtaxi.com\",\n  \"password\": \"password123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"register"
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 422 (Registro Rechazado por Email Duplicado)\", function () {",
							"    pm.response.to.have.status(422);",
							"});",
							"pm.test(\"Error en campo email\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.errors).to.have.property(\"email\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
